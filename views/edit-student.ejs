<!DOCTYPE html>
<html>

<head>
    <title>Edit Student</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="form-container">

        <h1>✏️ Edit Student</h1>

        <form action="/students/edit/<%= student._id %>" method="POST">

            <label>Name:</label>
            <input
                type="text"
                name="name"
                value="<%= student.name %>"
                required
            >

            <label>Age:</label>
            <input
                type="number"
                name="age"
                value="<%= student.age %>"
                required
            >

            <label>Course:</label>
            <input
                type="text"
                name="course"
                value="<%= student.course %>"
                required
            >

            <label>City:</label>
            <input
                type="text"
                name="city"
                value="<%= student.city %>"
                required
            >

            <button type="submit" class="submit-btn">
                Update Student
            </button>

        </form>

        <a href="/students" class="back-btn">
            ← Back to Students
        </a>

    </div>

</body>

</html>