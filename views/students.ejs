<!DOCTYPE html>
<html>

<head>
    <title>Student Management</title>

    <link rel="stylesheet" href="/style.css">
</head>
<script src="/theme.js"></script>

<body>

    <div class="container">

        <h1>
            🎓 Student Management System
        </h1>


        <!-- Dashboard -->
        <a href="/dashboard" class="dashboard-btn">
            📊 Dashboard
        </a>


        <!-- Add Student -->
        <a href="/students/add" class="dashboard-btn">
            ➕ Add Student
        </a>
        <a href="/students/export" class="excel-btn">
            📥 Export Excel
        </a>

        <!-- Search -->
        <form action="/students" method="GET" class="search-form">

            <input type="text" name="search" placeholder="Search student..." value="<%= search %>">

            <button type="submit">
                🔍 Search
            </button>

        </form>


        <!-- Filter -->
        <form action="/students" method="GET" class="filter-form">

            <!-- Course -->
            <select name="course">

                <option value="">
                    All Courses
                </option>

                <% courses.forEach((course)=> { %>

                    <% if (selectedCourse===course) { %>

                        <option value="<%= course %>" selected>
                            <%= course %>
                        </option>

                        <% } else { %>

                            <option value="<%= course %>">
                                <%= course %>
                            </option>

                            <% } %>

                                <% }) %>

            </select>


            <!-- Address -->
            <select name="address">

                <option value="">
                    All Addresses
                </option>

                <% addresses.forEach((address)=> { %>

                    <% if (selectedAddress===address) { %>

                        <option value="<%= address %>" selected>
                            <%= address %>
                        </option>

                        <% } else { %>

                            <option value="<%= address %>">
                                <%= address %>
                            </option>

                            <% } %>

                                <% }) %>

            </select>


            <button type="submit" class="filter">
                🔎 Filter
            </button>


            <a href="/students" class="clear-btn">
                Clear
            </a>

        </form>


        <!-- Students Table -->

        <div class="table-wrapper">

            <table class="students-table">

                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Course</th>
                        <th>Progress</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% students.forEach(student=> { %>

                        <tr>

                            <!-- PHOTO -->
                            <td>
                                <% if (student.photo) { %>

                                    <img src="<%= student.photo %>" alt="Student Photo" class="student-photo">

                                    <% } else { %>

                                        <div class="no-photo">
                                            👤
                                        </div>

                                        <% } %>
                            </td>


                            <!-- NAME -->
                            <td>
                                <strong>
                                    <%= student.name %>
                                </strong>
                            </td>


                            <!-- AGE -->
                            <td>
                                <%= student.age %>
                            </td>


                            <!-- COURSE -->
                            <td>
                                <%= student.course %>
                            </td>


                            <!-- PROGRESS -->
                            <td>

                                <div class="list-progress">

                                    <div class="list-progress-bar">

                                        <div class="list-progress-fill" style="width: <%= student.progress || 0 %>%">
                                        </div>

                                    </div>

                                    <span>
                                        <%= student.progress || 0 %>%
                                    </span>

                                </div>

                            </td>


                            <!-- ACTION -->
                            <td>

                                <div class="student-actions">

                                    <!-- VIEW -->
                                    <a href="/students/view/<%= student._id %>" class="view-student-btn">
                                        👁️ View
                                    </a>


                                    <!-- EDIT -->
                                    <a href="/students/edit/<%= student._id %>" class="edit-student-btn">
                                        ✏️ Edit
                                    </a>


                                    <!-- DELETE -->
                                    <a href="/students/delete/<%= student._id %>" class="delete-student-btn"
                                        onclick="return confirm('Are you sure you want to delete this student?')">
                                        🗑️ Delete
                                    </a>

                                </div>

                            </td>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>

    </div>


    <!-- ===============================
         PHOTO POPUP
    ================================ -->

    <div id="photoModal" class="photo-modal" onclick="closePhoto()">

        <span class="close-photo">
            &times;
        </span>

        <img id="largePhoto" class="large-photo" src="" alt="Student Photo" onclick="event.stopPropagation()">

    </div>


    <!-- ===============================
         JAVASCRIPT
    ================================ -->

    <script>

        // ===============================
        // Photo Popup
        // ===============================

        function openPhoto(photoUrl) {

            const modal =
                document.getElementById("photoModal");

            const image =
                document.getElementById("largePhoto");

            image.src = photoUrl;

            modal.style.display = "flex";

        }


        function closePhoto() {

            const modal =
                document.getElementById("photoModal");

            const image =
                document.getElementById("largePhoto");

            modal.style.display = "none";

            image.src = "";

        }


        // ===============================
        // Progress Bar
        // ===============================

        const progressBars =
            document.querySelectorAll(
                ".progress-fill"
            );


        progressBars.forEach((bar) => {

            const progress =
                Number(
                    bar.dataset.progress || 0
                );


            const safeProgress =
                Math.max(
                    0,
                    Math.min(
                        progress,
                        100
                    )
                );


            bar.style.width =
                safeProgress + "%";

        });

    </script>

</body>

</html>