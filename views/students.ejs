<!DOCTYPE html>
<html>

<head>
    <title>Student Management</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h1>🎓 Student Management System</h1>

        <a href="/students/add" class="add-btn">
            + Add Student
        </a>

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Course</th>
                    <th>City</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% students.forEach(student=> { %>

                    <tr>

                        <td>
                            <%= student.name %>
                        </td>

                        <td>
                            <%= student.age %>
                        </td>

                        <td>
                            <%= student.course %>
                        </td>

                        <td>
                            <%= student.city %>
                        </td>

                        <td>

                            <a href="/students/edit/<%= student._id %>" class="edit-btn">
                                Edit
                            </a>

                            <form action="/students/delete/<%= student._id %>" method="POST" style="display:inline;">
                                <button type="submit" class="delete-btn">
                                    Delete
                                </button>
                            </form>

                        </td>

                    </tr>

                    <% }) %>

            </tbody>

        </table>

    </div>

</body>

</html>