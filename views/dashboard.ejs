<!DOCTYPE html>
<html>

<head>
    <title>Student Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="dashboard-container">

        <!-- Header -->
        <div class="dashboard-header">

            <div>
                <h1>📊 Student Dashboard</h1>
                <p>Student Management System</p>
            </div>

            <a href="/logout" class="logout-btn">
                🚪 Logout
            </a>

        </div>


        <!-- Statistics Cards -->
        <div class="dashboard-cards">

            <!-- Total Students -->
            <div class="dashboard-card">

                <div class="card-icon">👨‍🎓</div>

                <h2>
                    <%= totalStudents %>
                </h2>

                <p>Total Students</p>

            </div>


            <!-- Total Courses -->
            <div class="dashboard-card">

                <div class="card-icon">📚</div>

                <h2>
                    <%= totalCourses %>
                </h2>

                <p>Total Courses</p>

            </div>


            <!-- Total Addresses -->
            <div class="dashboard-card">

                <div class="card-icon">🏠</div>

                <h2>
                    <%= totalAddresses %>
                </h2>

                <p>Total Addresses</p>

            </div>


            <!-- Average Progress -->
            <div class="dashboard-card">

                <div class="card-icon">📈</div>

                <h2>
                    <%= averageProgress %>%
                </h2>

                <p>Average Progress</p>

            </div>

        </div>


        <!-- Course Statistics -->
        <div class="dashboard-section">

            <h2>📚 Course-wise Students</h2>

            <div class="stats-list">

                <% courseCounts.forEach(course => { %>

                    <div class="stats-item">

                        <span>
                            <%= course._id || "Unknown" %>
                        </span>

                        <strong>
                            <%= course.count %>
                        </strong>

                    </div>

                <% }) %>

            </div>

        </div>


        <!-- Address Statistics -->
        <div class="dashboard-section">

            <h2>🏠 Address-wise Students</h2>

            <div class="stats-list">

                <% addressCounts.forEach(address => { %>

                    <div class="stats-item">

                        <span>
                            <%= address._id || "Unknown" %>
                        </span>

                        <strong>
                            <%= address.count %>
                        </strong>

                    </div>

                <% }) %>

            </div>

        </div>


        <!-- Exam Statistics -->
        <div class="dashboard-section">

            <h2>📝 Exam-wise Students</h2>

            <div class="stats-list">

                <% examCounts.forEach(exam => { %>

                    <div class="stats-item">

                        <span>
                            <%= exam._id || "Unknown Exam" %>
                        </span>

                        <strong>
                            <%= exam.count %>
                        </strong>

                    </div>

                <% }) %>

            </div>

        </div>


        <!-- Navigation -->
        <div class="dashboard-actions">

            <a href="/students" class="dashboard-btn">
                📋 Students List
            </a>

            <a href="/students/add" class="dashboard-btn">
                ➕ Add Student
            </a>

        </div>

    </div>

</body>

</html>