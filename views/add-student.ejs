<!DOCTYPE html>
<html>

<head>
    <title>Add Student</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="form-container">

        <h1>➕ Add Student</h1>

        <form action="/students" method="POST">

            <!-- =========================
                 BASIC STUDENT DETAILS
            ========================== -->

            <h2 class="form-section-title">
                👨‍🎓 Student Details
            </h2>

            <label>Student Name:</label>

            <input
                type="text"
                name="name"
                placeholder="Enter student name"
                required
            >


            <label>Father Name:</label>

            <input
                type="text"
                name="fatherName"
                placeholder="Enter father name"
                required
            >


            <label>Mobile Number:</label>

            <input
                type="tel"
                name="mobile"
                placeholder="Enter 10 digit mobile number"
                pattern="[0-9]{10}"
                maxlength="10"
                required
            >


            <label>Email:</label>

            <input
                type="email"
                name="email"
                placeholder="Enter email address"
                required
            >


            <label>Student Photo URL:</label>

            <input
                type="url"
                name="photo"
                placeholder="https://example.com/photo.jpg"
            >

            <small class="form-help">
                Abhi photo URL use kar sakte ho.
            </small>


            <label>Age:</label>

            <input
                type="number"
                name="age"
                placeholder="Enter age"
                min="1"
                max="100"
                required
            >


            <label>Course:</label>

            <input
                type="text"
                name="course"
                placeholder="Enter course"
                required
            >


            <label>Address:</label>

            <textarea
                name="address"
                placeholder="Enter complete address"
                rows="4"
                required
            ></textarea>


            <!-- =========================
                 EXAMS
            ========================== -->

            <div class="exam-header">

                <h2 class="form-section-title">
                    📝 Exam Details
                </h2>

                <button
                    type="button"
                    class="add-exam-btn"
                    onclick="addExam()"
                >
                    ➕ Add Exam
                </button>

            </div>


            <div id="exams-container">


                <!-- First Exam -->

                <div class="exam-box" data-exam-index="0">

                    <div class="exam-title-row">

                        <h3>
                            Exam 1
                        </h3>

                    </div>


                    <label>
                        Exam Name:
                    </label>

                    <input
                        type="text"
                        name="exams[0][examName]"
                        placeholder="Example: Mid Term"
                    >


                    <!-- Subjects -->

                    <div class="subjects-container">

                        <div
                            class="subject-box"
                            data-subject-index="0"
                        >

                            <h4>
                                Subject 1
                            </h4>


                            <label>
                                Subject Name:
                            </label>

                            <input
                                type="text"
                                name="exams[0][subjects][0][subjectName]"
                                placeholder="Example: Mathematics"
                            >


                            <label>
                                Total Marks:
                            </label>

                            <input
                                type="number"
                                name="exams[0][subjects][0][totalMarks]"
                                placeholder="Example: 100"
                                min="1"
                            >


                            <label>
                                Obtained Marks:
                            </label>

                            <input
                                type="number"
                                name="exams[0][subjects][0][obtainedMarks]"
                                placeholder="Example: 85"
                                min="0"
                            >


                            <button
                                type="button"
                                class="remove-subject-btn"
                                onclick="removeSubject(this)"
                            >
                                🗑️ Remove Subject
                            </button>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="add-subject-btn"
                        onclick="addSubject(this)"
                    >
                        ➕ Add Subject
                    </button>


                    <button
                        type="button"
                        class="remove-exam-btn"
                        onclick="removeExam(this)"
                    >
                        🗑️ Remove Exam
                    </button>

                </div>

            </div>


            <!-- Submit -->

            <button
                type="submit"
                class="submit-btn"
            >
                💾 Add Student
            </button>

        </form>


        <a
            href="/students"
            class="back-btn"
        >
            ← Back to Students
        </a>

    </div>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        let examIndex = 1;


        // =========================
        // Add Exam
        // =========================

        function addExam() {

            const container =
                document.getElementById("exams-container");


            const exam = document.createElement("div");

            exam.className = "exam-box";

            exam.setAttribute(
                "data-exam-index",
                examIndex
            );


            exam.innerHTML = `

                <div class="exam-title-row">

                    <h3>
                        Exam ${examIndex + 1}
                    </h3>

                </div>


                <label>
                    Exam Name:
                </label>

                <input
                    type="text"
                    name="exams[${examIndex}][examName]"
                    placeholder="Example: Final Exam"
                >


                <div class="subjects-container">

                    <div
                        class="subject-box"
                        data-subject-index="0"
                    >

                        <h4>
                            Subject 1
                        </h4>


                        <label>
                            Subject Name:
                        </label>

                        <input
                            type="text"
                            name="exams[${examIndex}][subjects][0][subjectName]"
                            placeholder="Example: Mathematics"
                        >


                        <label>
                            Total Marks:
                        </label>

                        <input
                            type="number"
                            name="exams[${examIndex}][subjects][0][totalMarks]"
                            placeholder="Example: 100"
                            min="1"
                        >


                        <label>
                            Obtained Marks:
                        </label>

                        <input
                            type="number"
                            name="exams[${examIndex}][subjects][0][obtainedMarks]"
                            placeholder="Example: 85"
                            min="0"
                        >


                        <button
                            type="button"
                            class="remove-subject-btn"
                            onclick="removeSubject(this)"
                        >
                            🗑️ Remove Subject
                        </button>

                    </div>

                </div>


                <button
                    type="button"
                    class="add-subject-btn"
                    onclick="addSubject(this)"
                >
                    ➕ Add Subject
                </button>


                <button
                    type="button"
                    class="remove-exam-btn"
                    onclick="removeExam(this)"
                >
                    🗑️ Remove Exam
                </button>

            `;


            container.appendChild(exam);

            examIndex++;

        }


        // =========================
        // Add Subject
        // =========================

        function addSubject(button) {

            const examBox =
                button.closest(".exam-box");


            const examIndex =
                examBox.getAttribute(
                    "data-exam-index"
                );


            const subjectsContainer =
                examBox.querySelector(
                    ".subjects-container"
                );


            const subjectIndex =
                subjectsContainer.children.length;


            const subject =
                document.createElement("div");


            subject.className =
                "subject-box";


            subject.setAttribute(
                "data-subject-index",
                subjectIndex
            );


            subject.innerHTML = `

                <h4>
                    Subject ${subjectIndex + 1}
                </h4>


                <label>
                    Subject Name:
                </label>

                <input
                    type="text"
                    name="exams[${examIndex}][subjects][${subjectIndex}][subjectName]"
                    placeholder="Example: English"
                >


                <label>
                    Total Marks:
                </label>

                <input
                    type="number"
                    name="exams[${examIndex}][subjects][${subjectIndex}][totalMarks]"
                    placeholder="Example: 100"
                    min="1"
                >


                <label>
                    Obtained Marks:
                </label>

                <input
                    type="number"
                    name="exams[${examIndex}][subjects][${subjectIndex}][obtainedMarks]"
                    placeholder="Example: 90"
                    min="0"
                >


                <button
                    type="button"
                    class="remove-subject-btn"
                    onclick="removeSubject(this)"
                >
                    🗑️ Remove Subject
                </button>

            `;


            subjectsContainer.appendChild(subject);

        }


        // =========================
        // Remove Subject
        // =========================

        function removeSubject(button) {

            const subjectBox =
                button.closest(".subject-box");


            const subjectsContainer =
                subjectBox.parentElement;


            // At least one subject should remain

            if (
                subjectsContainer.children.length === 1
            ) {

                alert(
                    "At least one subject is required."
                );

                return;

            }


            subjectBox.remove();

        }


        // =========================
        // Remove Exam
        // =========================

        function removeExam(button) {

            const examBox =
                button.closest(".exam-box");


            const container =
                document.getElementById(
                    "exams-container"
                );


            // At least one exam should remain

            if (
                container.children.length === 1
            ) {

                alert(
                    "At least one exam is required."
                );

                return;

            }


            examBox.remove();

        }

    </script>

</body>

</html>